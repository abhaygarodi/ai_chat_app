## FastAPI
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

## Providers
# LLM_PROVIDER: "extractive" (no LLM, offline) or "groq" (cloud LLM)
# EMBEDDINGS_PROVIDER: "hash"
LLM_PROVIDER=groq
EMBEDDINGS_PROVIDER=hash

## Groq (used when LLM_PROVIDER=groq)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=30
GROQ_TEMPERATURE=0.0

## Hash embeddings
HASH_EMBEDDING_DIM=1024

## Qdrant
# In production, point to Qdrant Cloud (https://cloud.qdrant.io).
# If QDRANT_URL is empty, falls back to local file-based Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=pdf_chunks
QDRANT_RECREATE_ON_DIM_MISMATCH=true

## Chunking / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_CONTEXT_CHARS=12000

## Extractive answering (used when LLM_PROVIDER=extractive)
EXTRACTIVE_MIN_SCORE=0.12
EXTRACTIVE_MAX_CHUNKS_SCAN=400

## OCR (only works if Tesseract is installed on the host)
ENABLE_OCR=false
OCR_LANG=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

## FastAPI
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

## Providers
# Options:
# - LLM_PROVIDER: extractive
# - EMBEDDINGS_PROVIDER: hash
#
# Free/offline quickstart:
#   LLM_PROVIDER=extractive
#   EMBEDDINGS_PROVIDER=hash
LLM_PROVIDER=extractive
EMBEDDINGS_PROVIDER=hash

## Hash embeddings (used when EMBEDDINGS_PROVIDER == "hash")
HASH_EMBEDDING_DIM=1024

## Qdrant (local persistent)
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=pdf_chunks
QDRANT_RECREATE_ON_DIM_MISMATCH=true

## Chunking / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_CONTEXT_CHARS=12000

## Extractive answering (used when LLM_PROVIDER == "extractive")
EXTRACTIVE_MIN_SCORE=0.12
EXTRACTIVE_MAX_CHUNKS_SCAN=400

## OCR (for scanned/image-only PDFs)
ENABLE_OCR=true
OCR_LANG=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
